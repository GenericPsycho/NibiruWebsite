---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";
import Paragraph from "@/components/tui/commons/paragraph.astro";

export interface Item {
  icon: string;
  text: string;
}

export interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<Container>
  <Label>bio</Label>
  <Content>
    {items.map(item => (
      <Paragraph>
        <span class="font-medium text-accent" class:list={[item.icon === "??" ? "text-dim" :  ""]}>{item.icon}</span>  <span class:list={[item.icon === "??" ? "" :  "ml-2", "[&_a]:text-inherit [&_a]:no-underline [&_a:hover]:text-inherit [&_a:hover]:no-underline"]} set:html={item.text} />
      </Paragraph>
    ))}
  </Content>
</Container>
